# The one public address (docs/DEPLOY.md). Caddy gets and renews the HTTPS certificate itself.
#   /api/*  -> the API, with /api stripped (the API's routes have no prefix)
#   /ws     -> the API's WebSocket
#   else    -> the dashboard (a single-page app: unknown paths get index.html)
{$NETRA_HOST} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /ws {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
