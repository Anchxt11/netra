# Copy to .env (never committed). Every value has a laptop default in docker-compose.yaml;
# on anything public (the Azure VM, docs/DEPLOY.md) set all of them. Use hex secrets
# (`openssl rand -hex 16`): the Postgres password goes inside a URL.

# The public name Caddy serves and gets a certificate for (docker-compose.azure.yaml)
NETRA_HOST=20-244-8-57.sslip.io
CORS_ORIGINS=https://20-244-8-57.sslip.io

# Dashboard sign-in, and the key that signs its tokens
ADMIN_PASSWORD=
ANALYST_PASSWORD=
JWT_SECRET=

# Databases (applied when their volume is first created; see docs/DEPLOY.md to change them later)
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# The read-only Power BI user netra_bi (docs/POWER_BI.md); the ops service sets it on every start
BI_PASSWORD=

# Optional
# ALERT_WEBHOOK_URL=        # Teams, Discord or Slack incoming webhook for failed jobs
# OPS_TZ=Asia/Kolkata       # time zone of the 02:00, 03:00 and 06:00 jobs
